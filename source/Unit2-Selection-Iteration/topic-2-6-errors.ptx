                <cell bottom="minor">Actual Output </cell>
            </row>  
            <row>
                <cell>0 repetitions</cell>
                <cell>-1</cell>
                <cell>Done!</cell>
                <cell> <fillin answer="Done!" mode="string" /></cell>
            </row>
            <row>
                <cell>1 repetition 7</cell>
                <cell>7  -1</cell>
                <cell>lucky number!</cell>
                <cell> <fillin answer="lucky number!" mode="string" /></cell>
            </row>
