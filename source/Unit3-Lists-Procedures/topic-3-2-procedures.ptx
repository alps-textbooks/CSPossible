    print("You got me at", x, y)
    # TODO: Increment the score variable and print it (remember to make it global!)
  

# move is called every 500 milliseconds to move the turtle to a new random location
def move():
    # TODO:Use the random.randint() function to choose random x and y coordinates between -200 and 200
  
