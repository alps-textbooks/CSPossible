<tests>
from unittest.gui import TestCaseGui

class myTests(TestCaseGui):
    def test1(self):
         # remove comments
        actual = "\n".join(
                       line for line in self.getEditorText().splitlines()
                      if line.strip() and not line.lstrip().startswith("#")
                      )    
        self.assertIn("defcalculate_total(price,quantity):", actual.replace(" ",""), "Define the calculate_total function with parameters price and quantity")
        self.assertIn("return", actual, "Use a return statement in the calculate_total function")
        count = actual.count("calculate_total(")
        self.assertLessEqual(4, count, "Call calculate_total at least 3 times")
        count = actual.count("*")
        self.assertEqual(1, count, "Use calculate_total() instead of repeated lines with * operator")
        self.assertEqual(15, calculate_total(5, 3), "calculate_total(5, 3) should return 15")

myTests().main()
    </tests>
  </program>
</activity>