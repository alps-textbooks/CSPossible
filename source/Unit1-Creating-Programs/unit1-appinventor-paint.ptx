        <url href="http://ai2.appinventor.mit.edu/?repo=templates.appinventor.mit.edu/trincoll/csp/unit3/templates/PaintPotMediaOnly/PaintPotMediaOnly.asc" target="_blank">
            open MIT App Inventor with the Paint Pot Template</url> and follow along with the following 
            <url href="https://www.youtube.com/watch?v=OoA8Q5v2sWg">video</url> 
            (<url href="https://teachertube.com/video/paint-pot-1-tutorial-476369">TeacherTube</url>)
            or your teacher or the 
    <url href="https://docs.google.com/document/d/164sPOhgX0uaTCyrWL-zxxKv_DdAA-IgVvOlU5vpYPPc/view">long handout</url>
	or <url href="https://docs.google.com/document/d/18thDoU6Ru3v9TTxhGfELuvwagm3bTNFYh-iXchDntGw/view">short handout section part 1</url>.	
    </p>
    <video youtube="OoA8Q5v2sWg" label="video-paint-pot1"/>
    
 </subsection>

