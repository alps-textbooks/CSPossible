  <subsection xml:id="vocab-1-7">
    <title>Vocabulary Review</title>

    <activity label="vocab-exprs">
      <statement>
        <p>
          Review the vocabulary in this lesson. Drag the vocabulary term from the left and drop it
          on its correct definition on the right.
          Click the "Check Me" button to see if you are correct.
        </p>
      </statement>

      <feedback>
        <p>Find the words in the lesson above and try again.</p>
      </feedback>

      <cardsort>
        <match>
          <premise>expression</premise>
          <response>combination of numbers, variables, and operators that 
      represents a value</response>
        </match>
        <match>
          <premise>increment</premise>
          <response>to increase a variable's value, often by adding 1 to it</response>
        </match>
        <match>
          <premise>integer</premise>
          <response>
            a numeric data type that represents positive and negative whole numbers, including zero.
          </response>
        </match>
        <match>
          <premise>modulo (%)</premise>
          <response>operator that returns the remainder of a division operation</response>
        </match>
        <match>
          <premise>random.randint</premise>
          <response>Python function that generates a random integer between two specified values (inclusive)</response>
        </match>
      </cardsort>
    </activity>

</subsection>

