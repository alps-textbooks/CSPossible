   <activity label="loop-test-cases">
    <title>Loop Test Plan</title>
      <statement><p>
          Run the code below following the test plan table underneath it. Fill in the actual output column of the table.
      </p> 
       <program label="loop-test-cases-sample-code" interactive="activecode" language="python">
        <code>
value = int(input("Enter a number (-1 to stop): "))
while value != -1:
    if value == 7:
        print("lucky number!")
    else:
        print("You entered", value)

    # 3. Update the loop variable with new input!
    value = int(input("Enter a another number (-1 to stop): "))
print("Done!")
        </code>
        </program>
      <table>
      <title>Test Cases</title>
          <tabular>
             <row header="yes">
                <cell bottom="minor">Test Case</cell>
                <cell bottom="minor">Input </cell>
                <cell bottom="minor">Expected Output </cell>
                <cell bottom="minor">Actual Output </cell>
            </row>  
            <row>
                <cell>0 repetitions</cell>
                <cell>-1</cell>
                <cell>Done!</cell>
                <cell> <fillin answer="Done!" mode="string" /></cell>
            </row>
            <row>
                <cell>1 repetition 7</cell>
                <cell>7  -1</cell>
                <cell>lucky number!</cell>
                <cell> <fillin answer="lucky number!" mode="string" /></cell>
            </row>
                <row>
                <cell>1 repetition not 7</cell>
                <cell>5  -1</cell>
                <cell>You entered 5</cell>
                <cell> <fillin answer="You entered 5" mode="string" /></cell>
            </row>
            </tabular>
            </table>
      </statement>
        <evaluation>
        <evaluate>
          <test>
            <strcmp use-answer="yes" />
            <feedback>Correct! </feedback>
          </test>
          <test>
            <feedback>Run the original code with the input to see the output. </feedback>
          </test>
        </evaluate>
          <evaluate>
          <test>
            <strcmp use-answer="yes" />
            <feedback>Correct! </feedback>
          </test>
          <test>
            <feedback>Run the original code with the input to see the output. </feedback>
