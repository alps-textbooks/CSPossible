        </evaluate>
          <evaluate>
          <test>
            <strcmp use-answer="yes" />
            <feedback>Correct! </feedback>
          </test>
          <test>
            <feedback>Run the original code with the input to see the output. </feedback>
          </test>
        </evaluate>
        </evaluation>
        </activity>


 </subsection>

 <subsection xml:id="LOs-2-6">
    <title>Learning Objectives</title>
    <remark>
      <title>2.6.A</title>
      <p>
        Correct errors in programs.
      </p>
    </remark>

    <remark>
      <title>2.6.B</title>
      <p>
        Develop code for test cases that can be used to check the correctness of an algorithm.
      </p>
    </remark>
  </subsection>

   <subsection xml:id="vocab-2-6">
    <title>Vocabulary Review</title>

    <activity label="vocab-errors">
      <statement>
        <p>
          Review the vocabulary in this lesson. Drag the vocabulary term from the left and drop it
          on its correct definition on the right.
          Click the "Check Me" button to see if you are correct.
        </p>
      </statement>

      <feedback>
        <p>Find the words in the lesson above and try again.</p>
      </feedback>

      <cardsort>
        <match>
          <premise>syntax error</premise>
          <response>an error caught by the interpreter because the rules of the programming language were not followed</response>
        </match>
        <match>
          <premise>logic error</premise>
          <response>an error in the code that causes it to produce incorrect results although it runs</response>
        </match>
        <match>
          <premise>runtime error</premise>
          <response>an error that occurs while the program is running</response>
        </match>
        <match>
        <premise>test cases</premise>
        <response>inputs used to check the correctness of an algorithm</response>
        </match>
      </cardsort>
    </activity>
  </subsection>
</section>
