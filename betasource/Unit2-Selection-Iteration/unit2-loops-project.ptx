     <tests>
from unittest.gui import TestCaseGui

class myTests(TestCaseGui):
    def findLine(self, lines, target):
        for line in lines:
            if target.replace(" ", "").lower() in line.replace(" ", "").lower():
                #print(line)
                return line
        return "None"
            
    def remove_comments(self, code):
        lines = code.split("\n")
        new_lines = []
        for line in lines:
            if "#" in line:
                line = line.split("#")[0]
            new_lines.append(line)
        return "\n".join(new_lines)
    
    def run_file(self, code, inputs):
        stars = "****************************************************************************" 
        print(stars)
        print("Testing code with inputs: " + inputs)
        print(stars)

        lines = code.split("\n")
        ins = inputs.split(",")
        inN = 0

        for i in range(len(lines)):
            if "input" in lines[i]:
                equals = lines[i].find("=") + 1
                if inN &lt; len(ins):
                    try:
                        int(ins[inN])  # Check if the input can be converted to a float
                        lines[i] = lines[i][0:equals] + str(ins[inN])
                    except ValueError:
                        lines[i] = lines[i][0:equals] + "\"" +ins[inN] + "\""
                inN += 1

        new_code = str("\n".join(lines))

        # Create an isolated scope for the code execution
        scope = {}

        ''' for ebook '''
        exec(new_code, scope)
        output = self.getOutput()
      
        ind = output.find(inputs) + len(inputs) + 1
        output = output[ind:].strip()
        ind = output.find(stars) + len(stars) + 1
        output = output[ind:]

        if (stars in output):
            ind = output.find(stars)
            output = output[0:ind].strip()
        
        #print(output)

        return str(output)
    
    def testOne(self):
        code = self.getEditorText()
        code = self.remove_comments(code)
        code_nospaces = code.replace(" ", "")

        #1 for loop
        loop = self.findLine(code.split("\n"), "range")
        loop_nospaces = loop.replace(" ", "")
        passed = "for" in loop and ("(1,8)" in loop_nospaces or "(0,7)" in loop_nospaces or "(7)" in loop_nospaces)
        self.assertTrue(passed, "Use range to repeat for 7 days: &lt;c&gt;" + loop + "&lt;/c&gt; &lt;em&gt;Note: if this is wrong, your calculations for total and average will be wrong below.&lt;/em&gt;")
        
        #2 if statements
        elif_count = code.count("elif ")
        if_count = code.count("if ") - elif_count
        self.assertLessEqual(2,if_count, "at least 2 if statements")

        #3 elif statements
        self.assertLessEqual(3,elif_count, "at least 3 if statements")
        
        #4 else statements
        else_count = code_nospaces.count("else:")
        self.assertLessEqual(2,else_count, "at least 8 else statements")
        

        #5 input statements
        input_count = code.count("input(")
        self.assertLessEqual(2,input_count, "at least 2 input statements")
        
        #6 while loop for input validation
        loop = self.findLine(code.split("\n"), "while")
        loop_nospaces = loop.replace(" ", "")
        passed = ("&lt;0" in loop_nospaces or "&lt;=-1" in loop_nospaces) and "or" in loop_nospaces and ("&gt;300" in loop_nospaces or "&gt;=301" in loop_nospaces)
        self.assertTrue(passed, "Uses while loops for input validation: " + loop)


        #7 average calculation for the 7 days using input "10,10,10,10,10,10,10" - Average = 40.0
        output = self.run_file(code, "10,10,10,10,10,10,10")
        results = self.findLine(output.split("\n"), "Needs Improvement") + "\n"
        results += self.findLine(output.split("\n"), "total") + "\n"
        results += self.findLine(output.split("\n"), "average") + "\n"
        results += self.findLine(output.split("\n"), "Keep working")
        passed = "70" in results and "10" in results and "keep working" in results.lower() and "needs improvement" in results.lower()
        self.assertTrue(passed, "Results for the 7 days using input \"10,10,10,10,10,10,10\" - Total = 70, Average = 10.0\n" + results)

        #8 results for input "25,25,25,25,25,25,25" - Good Job!
        output = self.run_file(code, "25,25,25,25,25,25,25")
        results = self.findLine(output.split("\n"), "Good") + "\n"
        results += self.findLine(output.split("\n"), "total") + "\n"
        results += self.findLine(output.split("\n"), "average") + "\n"
        results += self.findLine(output.split("\n"), "Good Job")
        passed = "175" in results and "25" in results and "good job" in results.lower() and "good" in results.lower()
        self.assertTrue(passed, "Results for the 7 days using input \"25,25,25,25,25,25,25\" - Total = 175, Average = 25.0\n" + results)

        #9 results for input "55,55,55,55,55,55,55" - Great Work!
        output = self.run_file(code, "55,55,55,55,55,55,55")
        results = self.findLine(output.split("\n"), "Great") + "\n"
        results += self.findLine(output.split("\n"), "total") + "\n"
        results += self.findLine(output.split("\n"), "average") + "\n"
        results += self.findLine(output.split("\n"), "Great Work")
        passed = "385" in results and "55" in results and "great work" in results.lower() and "great" in results.lower()
        self.assertTrue(passed, "Results for the 7 days using input \"55,55,55,55,55,55,55\" - Total = 385, Average = 55.0\n" + results)
        
        #10 results for input "65,65,65,65,65,65,65" - Fitness Champion!
        output = self.run_file(code, "65,65,65,65,65,65,65")
        results = self.findLine(output.split("\n"), "Excellent") + "\n" 
        results += self.findLine(output.split("\n"), "total") + "\n"
        results += self.findLine(output.split("\n"), "average") + "\n"
        results += self.findLine(output.split("\n"), "Fitness Champion")    
        passed = "455" in results and "65" in results and "fitness champion" in results.lower() and "excellent" in results.lower()
        self.assertTrue(passed, "Results for the 7 days using input \"65,65,65,65,65,65,65\" - Total = 455, Average = 65.0\n" + results)
        


        #7 results for input "10,10,10,10,10,10,10" - Keep working
        #8 results for input "25,25,25,25,25,25,25" - Good Job!
        #9 results for input "55,55,55,55,55,55,55" - Great Work!
        #10 results for input "65,65,65,65,65,65,65" - Fitness Champion!
        
myTests().main()
     </tests>
    </program>
    </project>
  </subsection>
  

