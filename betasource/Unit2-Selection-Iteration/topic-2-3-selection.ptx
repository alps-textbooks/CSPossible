        </choice>
        <choice>
          <cline>if x &gt; 2: </cline>
        </choice>
      </block>
      <block order="7">
        <cline>    message = "Hello"</cline>
      </block>
      <block order="8">
        <choice correct="yes">
          <cline>elif x &gt; 2:</cline>
        </choice>
        <choice>
          <cline>else x &gt; 2: </cline>
        </choice>
      </block>
      <block order="6">
        <cline>    message = "Hey"</cline>
      </block>
      <block order="1">
        <cline>else:</cline>
      </block>
