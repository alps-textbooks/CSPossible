      <cardsort>
        <match>
        <premise>iteration</premise>
        <response>repetition of a sequence of instructions</response>
        </match>
        <match>
          <premise>while loop</premise>
          <response>a type of loop that continues as long as a condition is true</response>
        </match>
        <match>
          <premise>for loop</premise>
          <response>a type of loop that repeats a set of statements a specific number of times</response>
        </match>
        <match>
          <premise>loop variable</premise>
          <response>a variable that is used to control the number of iterations in a loop</response>
        </match>
        <match>
          <premise>infinite loop</premise>
          <response>a loop that never ends</response>
        </match>
        <match>
