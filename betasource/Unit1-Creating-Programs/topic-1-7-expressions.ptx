        <tests>
          from unittest.gui import TestCaseGui

          class myTests(TestCaseGui):
            def test1(self):
              self.assertIn("minutes//60",self.getEditorText().replace(" ", ""),"Use minutes//60 to calculate hours")
              self.assertIn("minutes%60",self.getEditorText().replace(" ", ""),"Use minutes%60 to calculate remaining minutes")
              self.assertIn("minutes*60",self.getEditorText().replace(" ", ""),"Use minutes*60 to calculate seconds")

