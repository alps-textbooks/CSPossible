<section xml:id="functions-coding-practice">


  <title>Functions Coding Practice</title>

  
   <p>These coding exercises are adapted from the Python 
    for Everybody ebook by Dr. Barb Ericson on Runestone.
  </p>

 <activity xml:id="funct_welcome" label="funct_welcome">
          <statement>
            <p>Write a function called <c>welcome_message</c> that takes in a parameter <c>name</c> and
            prints <c>"Hello (name) :-)"</c>. For example,
            <c>welcome_message('Aurora')</c> should return <c>"Hello Aurora :-)"</c>.</p>
          </statement>
          <program interactive="activecode" language="python">
            <code>
def welcome_message(name):
    # write code here to print "Hello" to name followed by ":-)" 

welcome_message('Aurora')
welcome_message('Bo')
</code>
            <tests>
from unittest.gui import TestCaseGui

class myTests(TestCaseGui):

    def testOne(self):
        self.assertIn("print", self.getEditorText(), "Use print in function")
        self.assertIn(",name",self.getEditorText().replace(' ',''),"Use name in print")
        self.assertIn("Hello Aurora :-)",self.getOutput(),"welcome_message('Aurora')")
        self.assertIn("Hello Bo :-)",self.getOutput(),"welcome_message('Bo')")
myTests().main()
            </tests>
          </program>
         </activity>


      <activity label="funct_area" xml:id="funct_area">
          <statement>
            <p>Write a function called <c>area</c> that takes in parameters <c>width</c> and <c>length</c> and
                    returns the area (of the rectangle). For example, <c>area(5,4)</c> should return <c>20</c>.</p>
          </statement>
          <program interactive="activecode" language="python">
            <code>
def area(width, length):
    # write code here to return the area given width and length
    

print( area(5,4) )
</code>
            <tests>
from unittest.gui import TestCaseGui
class myTests(TestCaseGui):

    def testOne(self):
        self.assertEqual(7, area(1,7),"area(1,7)")
        self.assertEqual(20, area(5,4),"area(5,4)")
        self.assertIn("return", self.getEditorText(), "Use return in function")
        self.assertIn("*", self.getEditorText(), "Use * to multiply width and length in function")

myTests().main()
            </tests>
          </program>
        </activity>


        <activity xml:id="funct_address" label="funct_address">
          <statement>
            <p>Write a function called <c>address</c> that combines 3 different string address parameters (<c>city</c>, <c>state</c>, and <c>zip</c>) and returns a user's address.
                            After the <c>city</c> and <c>state</c> inputs, add a comma and a space. For example, <c>address('Seattle', 'WA', '98105')</c>
                             should return <c>"Seattle, WA, 98105"</c>.</p>
          </statement>
          <program interactive="activecode" language="python">
            <code>
# define the function address here


print(address('Seattle', 'WA', '98105'))
            </code>
            <tests>
from unittest.gui import TestCaseGui

class myTests(TestCaseGui):

    def testOne(self):
        self.assertIn("return", self.getEditorText(), "Use return in function")
        self.assertIn("+", self.getEditorText(), "Use + to concatenate the strings in function")
        self.assertEqual(3, len(address('Seattle', 'WA', '98105').split(',')),"len(address('Seattle', 'WA', '98105').split(','))")
        self.assertEqual("Seattle, WA, 98105", address('Seattle', 'WA', '98105'),"address('Seattle', 'WA', '98105')")
        self.assertEqual("Los Angeles, CA, 90005",address('Los Angeles', 'CA', '90005'),"address('Los Angeles', 'CA', '90005')")


myTests().main()
            </tests>
          </program>
  </activity>


     <activity xml:id="funct-ex-perimeterq" label="funct-ex-perimeterq">
          <statement>
            <p>Fix the 4 errors so the following code runs and returns the perimeter of a rectangle.
                 For example, <c>recPerimeter(10, 20)</c> should return <c>60</c>.</p>
          </statement>
          <program interactive="activecode" language="python">
            <code>
def recPerimeter(length, width)
perimeter = 2 * (length + width)
    Return Perimeter

print(recPerimeter(10, 20))
</code>
            <tests>
from unittest.gui import TestCaseGui
class myTests(TestCaseGui):

    def testOne(self):
        self.assertIn(":", self.getEditorText(), "Use : in function header")
        self.assertEqual(60, recPerimeter(10, 20),"recPerimeter(10, 20)")
        self.assertEqual(10.0, recPerimeter(3.0, 2), "recPerimeter(3.0, 2)")

myTests().main()
            </tests>
          </program>
        </activity>

        <activity xml:id="funct_ex_squareq" label="funct_ex_squareq">
          <statement>
            <p>Fix the 5 errors so the following code runs and returns the area of a square. 
                For example, <c>squareArea(10)</c> should return <c>100</c>.</p>
          </statement>
          <program interactive="activecode" language="python">
            <code>
Def squareArea(sideLength)
    area = length * length
    return squareArea

print(squareArea(10))
</code>
            <tests>
from unittest.gui import TestCaseGui
class myTests(TestCaseGui):

    def testOne(self):
        self.assertIn(":", self.getEditorText(), "Use : in function header")
        self.assertIn("return", self.getEditorText(), "Use return in function")
        self.assertEqual(100, squareArea(10), "squareArea(10)")
        self.assertEqual(529, squareArea(23), "squareArea(23)")

myTests().main()
            </tests>
          </program>
        </activity>

        <activity xml:id="funct_ex_triangleq" label="funct_ex_triangleq">
          <statement>
            <p>Change the code so that <c>areaTriangle</c> takes parameters for the base and height of a triangle
                and computes its area. For example, <c>areaTriangle(12,45)</c> should return <c>270</c>.</p>
          </statement>
          <program interactive="activecode" language="python">
            <code>
# Add the parameters for base and height to the function definition
# instead of hardcoding the values of base and height in the function body                
def areaTriangle():
    base = 5
    height = 4
    area = (base * height) / 2
    return area

print(areaTriangle(12,45))
</code>
            <tests>
from unittest.gui import TestCaseGui
class myTests(TestCaseGui):

    def testOne(self):
        self.assertIn("defareaTriangle(base,height)", self.getEditorText().replace(' ',''), "Add base and height as parameters to the function definition")   
        self.assertNotIn("base = 5", self.getEditorText(), "Don't hardcode the base value in the function body")
        self.assertNotIn("height = 4", self.getEditorText(), "Don't hardcode the height value in the function body")
        
        self.assertEqual(270,areaTriangle(12,45),"areaTriangle(12,45)")
        self.assertEqual(10,areaTriangle(5,4),"areaTriangle(5,4)")

myTests().main()
            </tests>
          </program>
         
        </activity>

        <activity xml:id="funct_ex_tripq" label="funct_ex_tripq">
          <statement>
            <p>Change the code below to create a function <c>tripCost</c> that calculates the cost of a trip.
                    It should take the <c>miles</c>, <c>milesPerGallon</c>, and <c>pricePerGallon</c> as parameters and
                    should return the cost of the trip. For example, <c>tripCost(100, 25, 2.24)</c> 
                    should return <c>8.96</c>.</p>
          </statement>
          <program interactive="activecode" language="python">
            <code>
# Change the code to a function tripCost 
#   that takes miles, milesPerGallon, and pricePerGallon as parameters
miles = 500
milesPerGallon = 26
pricePerGallon = 3.45
numGallons = miles / milesPerGallon
total = numGallons * pricePerGallon
print(total)

# Call the function tripCost here and print the result
#tripCost(100, 25, 2.24) # should return 8.96
</code>
            <tests>
from unittest.gui import TestCaseGui
class myTests(TestCaseGui):

    def testOne(self):
        self.assertIn("deftripCost(miles,milesPerGallon,pricePerGallon):", self.getEditorText().replace(' ',''), "Change the code to a function tripCost that takes miles, milesPerGallon, and pricePerGallon as parameters")
        self.assertIn("return", self.getEditorText(), "Use return in function")
        self.assertNotIn("miles = 500", self.getEditorText(), "Don't hardcode the miles value in the function body")
        self.assertNotIn("milesPerGallon = 26", self.getEditorText(), "Don't hardcode the milesPerGallon value in the function body")
        self.assertNotIn("pricePerGallon = 3.45", self.getEditorText(), "Don't hardcode the pricePerGallon value in the function body")
        self.assertEqual(8.96,tripCost(100, 25, 2.24),"tripCost(100, 25, 2.24)")
        self.assertEqual(37.625,tripCost(250, 20, 3.01),"tripCost(250, 20, 3.01)")

myTests().main()
            </tests>
          </program>
        </activity>

   <activity label="funct_miles" xml:id="funct_miles">
    <statement>
      <p>Write a function called <c>convert</c> that takes in <c>feet</c> as a parameter and
            returns the value in miles.  1 mile is equal to 5280 feet.</p>
    </statement>
    <program interactive="activecode" language="python">
      <code>
# Define the function convert(feet) which converts feet and returns the value in miles.

print(convert(5280))  # should print 1.0
print(convert(10560))  # should print 2.0
</code>
      <tests>
from unittest.gui import TestCaseGui
class myTests(TestCaseGui):

    def testOne(self):
        self.assertIn("return", self.getEditorText(), "Use return in function")
        self.assertIn("/", self.getEditorText(), "Use / to divide feet by 5280 in function")
        self.assertEqual(1.0, convert(5280), "convert(5280)")
        self.assertEqual(2.0, convert(10560), "convert(10560)")

myTests().main()
      </tests>
    </program>
  </activity>

   <activity label="funct_ave" xml:id="funct_ave">
    <statement>
      <p>Write a function called <c>average(num1, num2)</c>, which finds the average of two numbers 
        <c>num1</c> and <c>num2</c>.  For example, <c>average(10,4)</c> should return <c>7.0</c>.</p>
    </statement>
    <program  interactive="activecode" language="python">
      <code>
# Define the function average(num1, num2) here


print(average(10,4))
</code>
      <tests>
from unittest.gui import TestCaseGui

class myTests(TestCaseGui):

    def testOne(self):
        self.assertIn("return", self.getEditorText(), "Use return in function")
        self.assertIn("def average", self.getEditorText(), "Define the function average")
        self.assertIn("/", self.getEditorText(), "Use / to divide the sum of the two numbers by 2")
        self.assertEqual(17.5, average(32,3), "average(32,3)")
        self.assertEqual(12.5, average(5,20), "average(5,20)")


myTests().main()
      </tests>
    </program>
  </activity>

   <activity label="funct_bigger" xml:id="funct_bigger">
    <statement>
      <p>Write a function called <c>bigger(p1, p2)</c> which returns whichever is greater of its 
        two parameters.</p>
    </statement>
    <program interactive="activecode" language="python">
      <code>
# Define the function bigger(p1, p2) here




print(bigger(15,20))  # should print 20
</code>
      <tests>
from unittest.gui import TestCaseGui

class myTests(TestCaseGui):

    def testOne(self):
        self.assertIn("return", self.getEditorText(), "Use return in function")
        self.assertIn("if", self.getEditorText(), "Use if statement to check which parameter is greater")
        self.assertEqual(20, bigger(20,15), "bigger(20,15)")
        self.assertEqual(8, bigger(2,8), "bigger(2,8)")
        self.assertEqual(1, bigger(-1,1), "bigger(-1,1)")

myTests().main()
      </tests>
    </program>
  </activity>

   <activity label="funct_even_or_odd" xml:id="funct_even_or_odd">
    <statement>
      <p>Write a function called <c>even_or_odd</c> that takes in a parameter <c>num</c>. 
If <c>num</c> is odd, return <c>"odd"</c>, and if <c>num</c> is even, return <c>"even"</c>.
For example, <c>even_or_odd(-65)</c> should return <c>"odd"</c>. 
Note: For this function, <c>num</c> is solely an integer. Remember that you can use <c>% 2 == 0</c> to
check if a number is even with no remainder when divided by 2.</p>
    </statement>
    <program interactive="activecode" language="python">
      <code>
# Define the function even_or_odd(num) here

# Call the function even_or_odd with 100 here and print the result

 </code>
 <tests>
from unittest.gui import TestCaseGui
class myTests(TestCaseGui):

    def testOne(self):
        self.assertIn("return", self.getEditorText(), "Use return in function")
        self.assertIn("%", self.getEditorText(), "Use % 2 to check if num is even or odd")
        self.assertIn("print(", self.getEditorText(), "Use print to print the result of calling the function")
        self.assertIn("even_or_odd(100)", self.getEditorText(), "Call the function even_or_odd with 100")
        self.assertEqual("even", even_or_odd(100),"Result of even_or_odd(100)")
        self.assertEqual("odd", even_or_odd(-65),"Result of even_or_odd(-65)")

myTests().main()
      </tests>
    </program>
  </activity>

  <activity label="funct_list" xml:id="funct_list">
    <statement>
      <p>Write a function called <c>list_sum</c> that takes in a parameter <c>num_list</c>, which is a list of numbers.
The function should return the sum of all the numbers in the list. For example, <c>list_sum([1, 2, 3])</c> should return <c>6</c>.
  Hint: Use a for loop to iterate through the list and add each number to a total sum variable.
      </p> 
    </statement>
    <program interactive="activecode" language="python">
      <code>
# Define the function list_sum(num_list) here


print( list_sum([1, 2, 3]) ) # should return 6
</code>
        <tests>
from unittest.gui import TestCaseGui

class myTests(TestCaseGui):
    def testOne(self):
        self.assertIn("return", self.getEditorText(), "Use return in function")
        self.assertIn("def list_sum(num_list):", self.getEditorText(), "Define the function list_sum with a parameter")
        self.assertIn("for", self.getEditorText(), "Use a for loop to iterate through the list")
        self.assertEqual(6, list_sum([1, 2, 3]), "list_sum([1, 2, 3])")
        self.assertEqual(20, list_sum([5, 10, 5]), "list_sum([5, 10, 5])")
        self.assertEqual(0, list_sum([]), "list_sum([])")

myTests().main()
        </tests>
        </program>
        </activity>
  </section>
