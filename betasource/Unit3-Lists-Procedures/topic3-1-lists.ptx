        </p>
      </statement>

       <choices randomize="yes">
        <choice>
          <statement>
            <p>chairs[0]</p>
          </statement>

          <feedback>
            <p>
              No, this would access "Alex". Remember that the first element in
              an array starts at index 0.
            </p>
          </feedback>
        </choice>

        <choice>
          <statement>
            <p>chairs[1]</p>
          </statement>

          <feedback>
            <p>
              No, this would access "Sam". Remember that the first element in
