        <code>
# Quiz App
# TODO: Create 2 parallel lists of data


# TODO: Introduce the data using a for-loop


# TODO: Ask "Who do you want to learn about" and get input 
# Use a for-loop with i in the range of len(list) to search one of the lists
# If you find the input in the list, print the corresponding information from the other list

# TODO: Start the Quiz! 
# Use a for-loop with i in the range of len(list) 
# Ask questions based on one of the lists 
# Get the input answer from the user 
# Check if the answer is correct using the other list


</code>
<tests>
from unittest.gui import TestCaseGui
class myTests(TestCaseGui):
    def findLine(self, lines, target):
        for line in lines:
            if "#" in line:
                index = line.find("#")
                line = line[0:index]
            if target in line.replace(" ", ""):
                #print(line)
                return line
        return "None"
            
    def test1(self):
            lines = self.getEditorText().replace(" ", "").split("\n")
            self.assertIn("=[", self.findLine(lines,"=[") , "Create 2 parallel lists of data")
            count = self.getEditorText().count("for ")
            self.assertLessEqual(3, count, "Code should have 3 for-loops")
            self.assertIn("range(len(", self.findLine(lines,"range(len(") , "Use range(len(yourlist)) to traverse the lists by index in some for-loops")            
            self.assertIn("[i]", self.getEditorText(), "Use [i] in the loop to ask the question")
            self.assertIn("input(", self.getEditorText(), "Use input")
            self.assertIn("else:", self.getEditorText(), "Use if/else in the loop to check if the answer is correct")

myTests().main()
</tests>
</program>
</project>

