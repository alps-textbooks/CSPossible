<tests>
from unittest.gui import TestCaseGui

class myTests(TestCaseGui):
    def findLine(self, lines, target):
        for line in lines:
            if target.replace(" ", "").lower() in line.replace(" ", "").lower():
                #print(line)
                return line
        return "None"
            
    def remove_comments(self, code):
        lines = code.split("\n")
        new_lines = []
        for line in lines:
            if "#" in line:
                line = line.split("#")[0]
            new_lines.append(line)
        return "\n".join(new_lines)
    
    def run_file(self, code, list, inputs):
        stars = "****************************************************************************" 
        print(stars)
        print("Testing code with inputs: " + str(list))
        print(stars)

        lines = code.split("\n")
        ins = inputs.split(",")
        inN = 0

        for i in range(len(lines)):
            if "= []" in lines[i]:
                lines[i] = lines[i].replace("= []", "= " + str(list))
            if "=input(" in lines[i].replace(" ", ""):
                equals = lines[i].find("=") + 1
                try:
                    int(ins[inN])  # Check if the input can be converted to a float
                    lines[i] = lines[i][0:equals] + str(ins[inN])
                except ValueError:
                    lines[i] = lines[i][0:equals] + "\"" +ins[inN] + "\""
                inN += 1

        new_code = str("\n".join(lines))

        #print(new_code)

        # Create an isolated scope for the code execution
        scope = {}

        ''' for ebook '''
        exec(new_code, scope)
        output = self.getOutput()

        if (stars in output):
            ind = output.find(stars) + len(str(stars)) + 1
            output = output[ind:].strip()
            ind = output.find(stars) + len(stars) + 1
            output = output[ind:]
        
        if (stars in output):
            ind = output.find(stars)
            output = output[0:ind].strip()
        
        return str(output)
    
    def testOne(self):
        code = self.getEditorText()
        code = self.remove_comments(code)
        #code_nospaces = code.replace(" ", "")

        list1 = [10, 15, 25, 40]
        #output = self.run_file(code, list1, "-1")

        result = calculate_total(list1)
        self.assertEqual(90, result, "calculate_total() for " + str(list1))

        result1 = calculate_average(list1)
        result2 = calculate_average([])
        self.assertEqual("22.5,-1", str(result1) + "," + str(result2), "calculate_average() for " + str(list1) + " and []")
        
        result = find_max_price(list1)
        self.assertEqual(40, result, "find_max_price() for " + str(list1))

        result = find_min_price(list1)
        self.assertEqual(10, result, "find_min_price() for " + str(list1))

        list1 = [10, 15, 25, 40, 10, 10, 10, 15, 25, 40, 15, 40, 10, 15]
        output = self.run_file(code, list1, "-1")

        line = self.findLine(output.split("\n"), "Total")
        self.assertIn("280.00", line, "Prints Total revenue generated for " + str(list1))

        line = self.findLine(output.split("\n"), "Average")
        self.assertIn("20.00", line, "Prints Average ticket price for " + str(list1))

        line = self.findLine(output.split("\n"), "High")
        self.assertIn("40.00", line, "Prints Highest ticket price sold for " + str(list1))
        
        line = self.findLine(output.split("\n"), "Low")
        self.assertIn("10.00", line, "Prints Lowest ticket price sold for " + str(list1))

        line = self.findLine(output.split("\n"), "Number of tickets sold at $10")
        self.assertIn("5", line, "Number of tickets sold at $10 for " + str(list1))

        num_formats = code.count("format(")
        num_2fs = code.count(".2f") + code.count(".02F")
        self.assertTrue(num_formats &gt;= 4 and num_2fs &gt;= 4, "You should use format(*, \".2f\") to format the average price to two decimal places.")
             
myTests().main()
</tests>
</program>
</project>
