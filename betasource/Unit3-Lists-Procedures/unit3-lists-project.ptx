<tests>
from unittest.gui import TestCaseGui

class myTests(TestCaseGui):
    def findLine(self, lines, target):
        for line in lines:
            if target.replace(" ", "").lower() in line.replace(" ", "").lower():
                #print(line)
                return line
        return "None"
            
    def remove_comments(self, code):
        lines = code.split("\n")
        new_lines = []
        for line in lines:
            if "#" in line:
                line = line.split("#")[0]
            new_lines.append(line)
        return "\n".join(new_lines)
    
    def run_file(self, code, inputs):
        stars = "****************************************************************************" 
        print(stars)
        print("Testing code with inputs: " + inputs)
        print(stars)

        lines = code.split("\n")
        ins = inputs.split(",")
        inN = 0

        for i in range(len(lines)):
            if "input" in lines[i] and not "#" in lines[i]:
                equals = lines[i].find("=") + 1
                if inN &lt; len(ins):
                    try:
                        float(ins[inN])  # Check if the input can be converted to a float
                        lines[i] = lines[i][0:equals] + str(ins[inN])
                    except ValueError:
                        lines[i] = lines[i][0:equals] + "\"" +ins[inN] + "\""
                    inN += 1

        code = str("\n".join(lines))

        # Create an isolated scope for the code execution
        scope = {}

        ''' for ebook '''
        exec(code, scope)
        output = self.getOutput()

        ind = output.find(inputs) + len(inputs) + 1
        output = output[ind:].strip()
        ind = output.find(stars) + len(stars) + 1
        output = output[ind:]

        if (stars in output):
            ind = output.find(stars)
            output = output[0:ind].strip()
        
        return str(output)
    
    def testOne(self):
        code = self.getEditorText()
        code = self.remove_comments(code)
        lines = code.replace(" ", "").split("\n")

        code_nospaces = code.replace(" ", "")

        #1 input statements
        input_count = code.count("input(")
        self.assertLessEqual(4,input_count, "at least 4 input statements")

        #2 count if statements
        elif_count = code.count("elif ")
        if_count = code.count("if ") - elif_count
        self.assertLessEqual(9,if_count, "at least 9 if statements")

        #3 count elif statements
        self.assertLessEqual(3,elif_count, "at least 3 elif statements")

        #4 count else statements
        else_count = code_nospaces.count("else:")
        self.assertLessEqual(8,else_count, "at least 8 else statements")
        
       
        
myTests().main()
</tests>
</program>
</project>
