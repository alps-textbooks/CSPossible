<tests>
import ast
from unittest.gui import TestCaseGui

class myTests(TestCaseGui):
       
    def findLine(self, lines, target):
        for line in lines:
            if target.replace(" ", "").lower() in line.replace(" ", "").lower():
                #print(line)
                return line
        return target + " not found"
            
    def remove_comments(self, code):
        lines = code.split("\n")
        new_lines = []
        for line in lines:
            if "#" in line:
                line = line.split("#")[0]
            new_lines.append(line)
        return "\n".join(new_lines)
    
    def run_file(self, code, inputs):
        stars = "****************************************************************************" 
        print(stars)
        print("Testing code with inputs: " + inputs)
        print(stars)

        lines = code.split("\n")
        ins = inputs.split(",")
        inN = 0

        for i in range(len(lines)):
            if "input" in lines[i]:
                equals = lines[i].find("=") + 1
                if inN &lt; len(ins):
                    lines[i] = lines[i][0:equals] + "\"" +ins[inN] + "\""
                inN += 1

        new_code = str("\n".join(lines))

        #print(new_code)

        # Create an isolated scope for the code execution
        scope = {}

        exec(new_code, scope)
        output = self.getOutput()

        
        if (stars in output):
            ind = output.find(inputs) + len(inputs) + 1
            output = output[ind:].strip()
            ind = output.find(stars) + len(stars) + 1
            output = output[ind:]
        

        if (stars in output):
            ind = output.find(stars)
            output = output[0:ind].strip()
        
        #print(output)

        return str(output)
    
    def testOne(self):
        code = self.getEditorText()
        code = self.remove_comments(code)
        code_nospaces = code.replace(" ", "")

        # 4 boolean variables
        num_false = code_nospaces.count("=False")
        self.assertLessEqual(4,num_false, "set boolean variables to False at least 4 times")

        num_true = code_nospaces.count("=True")
        self.assertLessEqual(4,num_true, "set boolean variables to True at least 4 times")

        # defines a function with single parameter
        tree = ast.parse(code)
        function = next((node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name == "check_password"), None)
        self.assertIsNotNone(function, "define a function named check_password")
        if function is not None:
            parameters = function.args
            num_parameters = len(parameters.posonlyargs) + len(parameters.args) + len(parameters.kwonlyargs)
            num_parameters += int(parameters.vararg is not None) + int(parameters.kwarg is not None)
            self.assertEqual(num_parameters, 1, "define check_password with a single parameter")
        
        # For loop
        line = self.findLine(code.split("\n"), "for")
        self.assertIn("in", line, "use a for loop to iterate through each letter in the password")
        
        # too short
        output = self.run_file(code, "short")
        self.assertIn("not long enough", output, "check for password length less than 12 characters and print 'Your password is not long enough.'")

        # numbers
        output = self.run_file(code, "NoNumbersHere!")
        self.assertIn("does not contain any numbers", output, "check for numbers in the password and print 'Your password does not contain any numbers.' if none are found")
        # uppercase letters
        output = self.run_file(code, "nouppercase12!")
        self.assertIn("does not contain any uppercase letters", output, "check for uppercase letters in the password and print 'Your password does not contain any uppercase letters.' if none are found")

        # lowercase letters
        output = self.run_file(code, "NOLOWERCASE12!")
        self.assertIn("does not contain any lowercase letters", output, "check for lowercase letters in the password and print 'Your password does not contain any lowercase letters.' if none are found")

        # special characters
        output = self.run_file(code, "NoSpecialCharacters12")
        self.assertIn("does not contain any special characters", output, "check for special characters in the password and print 'Your password does not contain any special characters.' if none are found")

        # strong
        output = self.run_file(code, "StrongPassword12!")
        self.assertIn("Your password is strong", output, "check for a strong password and print 'Your password is strong.' if all requirements are met")

myTests().main()
</tests>
</program>
</project>
